# =============================================================================
# GrandGold - Environment Variables Reference
# =============================================================================
# Copy this file to .env.local (frontend) or pass as env vars to each service.
# NEVER commit real secrets to version control.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/grandgold

# --- Redis ---
REDIS_URL=redis://HOST:6379

# --- JWT / Auth (REQUIRED in production) ---
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Frontend (Next.js) ---
NEXT_PUBLIC_APP_URL=https://thegrandgold.com
NEXT_PUBLIC_AUTH_SERVICE_URL=http://auth-service:4001
NEXT_PUBLIC_ORDER_SERVICE_URL=http://order-service:4004
NEXT_PUBLIC_PRODUCT_SERVICE_URL=http://product-service:4007
NEXT_PUBLIC_PAYMENT_SERVICE_URL=http://payment-service:4005
NEXT_PUBLIC_KYC_SERVICE_URL=http://kyc-service:4006
NEXT_PUBLIC_SELLER_SERVICE_URL=http://seller-service:4002
NEXT_PUBLIC_FINTECH_SERVICE_URL=http://fintech-service:4003
NEXT_PUBLIC_INVENTORY_SERVICE_URL=http://inventory-service:4008
NEXT_PUBLIC_AI_SERVICE_URL=http://ai-service:4009
NEXT_PUBLIC_PROMOTION_SERVICE_URL=http://promotion-service:4010
NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=http://notification-service:4011

# --- Payment Gateways ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...

# --- Search (Meilisearch) ---
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=CHANGE_ME

# --- CORS ---
CORS_ORIGINS=https://thegrandgold.com

# --- Logging ---
LOG_LEVEL=info
NODE_ENV=production
